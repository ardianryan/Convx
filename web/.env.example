# ==========================================
# CONVX MUSIC — ENVIRONMENT VARIABLES
# ==========================================

# [WAJIB UNTUK RELAY] Cloudflare Account ID
# Cara dapat: dash.cloudflare.com -> Di sidebar kanan bawah terlihat "Account ID"
CF_ACCOUNT_ID=your_cloudflare_account_id_here

# [WAJIB UNTUK RELAY] Cloudflare API Token
# Cara dapat: My Profile -> API Tokens -> Create Token -> Template "Edit Cloudflare Workers"
# Izin minimal: Account -> Workers Scripts -> Edit
CF_API_TOKEN=your_cloudflare_api_token_here

# [OTOMATIS / OPSIONAL] URL Cloudflare Worker yang sudah dideploy
# Variabel ini akan otomatis diisi oleh wizard instalasi Convx saat dideploy
CF_WORKER_URL=https://convx-relay.yoursubdomain.workers.dev

# [OPSIONAL] Nama Branding Platform (Default: Convx Music)
PLATFORM_NAME=Convx Music

# [OPSIONAL] Port Server Utama (Default: 7554)
PORT=7554

# [OPSIONAL] Port Internal Backend Audio Go (Default: 7555)
GO_BACKEND_PORT=7555
